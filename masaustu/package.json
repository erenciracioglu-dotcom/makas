{
  "name": "makas-masaustu",
  "productName": "Makas",
  "version": "1.1.0",
  "description": "Makas video düzenleyici - Windows masaüstü sürümü (ekran kartıyla hızlandırılmış)",
  "author": "Eren Çıracıoğlu",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "npm run app-hazirla && electron .",
    "dist": "npm run app-hazirla && electron-builder --win nsis portable --x64",
    "app-hazirla": "node -e \"require('fs').mkdirSync('app',{recursive:true});require('fs').copyFileSync('../index.html','app/index.html')\""
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.erenciracioglu.makas",
    "productName": "Makas",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Makas",
      "artifactName": "Makas-Kurulum-${version}.exe"
    },
    "portable": {
      "artifactName": "Makas-Tasinabilir-${version}.exe"
    }
  }
}
